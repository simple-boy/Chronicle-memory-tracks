{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chronicle track API definitions",
  "description": "Select the named definition for the track/operation. Decoded media limits and idempotency are runtime constraints.",
  "$defs": {
    "codingAdd": {
      "type": "object",
      "required": [
        "request_id",
        "user_id",
        "session_id",
        "messages"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "timestamp": {
                "type": "integer",
                "description": "Unix milliseconds, if provided; runtime checks datetime range."
              }
            }
          }
        }
      }
    },
    "multimodalAdd": {
      "type": "object",
      "required": [
        "request_id",
        "user_id",
        "session_id",
        "messages"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "required": [
                            "type",
                            "text"
                          ],
                          "properties": {
                            "type": {
                              "const": "text"
                            },
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "\\S"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "type",
                            "image_url"
                          ],
                          "properties": {
                            "type": {
                              "const": "image_url"
                            },
                            "image_url": {
                              "type": "object",
                              "required": [
                                "url"
                              ],
                              "properties": {
                                "url": {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "Inline Base64 JPEG/PNG/WebP Data URI; runtime verifies encoding, MIME, file format and decoded limits."
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              "timestamp": {
                "type": "integer",
                "description": "Unix milliseconds, if provided; runtime checks datetime range."
              }
            }
          }
        }
      }
    },
    "codingSearch": {
      "type": "object",
      "required": [
        "query",
        "user_id",
        "top_k"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "multimodalSearch": {
      "type": "object",
      "required": [
        "query",
        "user_id",
        "top_k"
      ],
      "properties": {
        "query": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "type",
                      "text"
                    ],
                    "properties": {
                      "type": {
                        "const": "text"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "type",
                      "image_url"
                    ],
                    "properties": {
                      "type": {
                        "const": "image_url"
                      },
                      "image_url": {
                        "type": "object",
                        "required": [
                          "url"
                        ],
                        "properties": {
                          "url": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Inline Base64 JPEG/PNG/WebP Data URI; runtime verifies encoding, MIME, file format and decoded limits."
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          ]
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "addResponse": {
      "type": "object",
      "required": [
        "success",
        "request_id",
        "user_id",
        "session_id"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "codingSearchResponse": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "id",
              "content"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "score": {
                "type": "number"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "multimodalSearchResponse": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "id",
              "content"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "content": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "required": [
                            "type",
                            "text"
                          ],
                          "properties": {
                            "type": {
                              "const": "text"
                            },
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "\\S"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "type",
                            "image_url"
                          ],
                          "properties": {
                            "type": {
                              "const": "image_url"
                            },
                            "image_url": {
                              "type": "object",
                              "required": [
                                "url"
                              ],
                              "properties": {
                                "url": {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "Inline Base64 JPEG/PNG/WebP Data URI; runtime verifies encoding, MIME, file format and decoded limits."
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              "score": {
                "type": "number"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
