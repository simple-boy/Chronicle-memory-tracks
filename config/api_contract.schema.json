{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForgeTrace Coding Add/Search public contract",
  "description": "Implementation schema based on the current official API Guide; UTF-8, byte budgets, duplicate JSON keys and authentication are additionally enforced by the service.",
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "message": {
      "type": "object", "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["user", "assistant"]},
        "content": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "timestamp": {"type": "integer", "description": "Unix milliseconds; must be representable as a UTC datetime"}
      },
      "additionalProperties": true
    },
    "addRequest": {
      "type": "object", "required": ["request_id", "user_id", "session_id", "messages"],
      "properties": {
        "request_id": {"$ref": "#/$defs/identifier"},
        "user_id": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "messages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/message"}}
      },
      "additionalProperties": true
    },
    "addResponse": {
      "type": "object", "required": ["success", "request_id", "user_id", "session_id"],
      "properties": {
        "success": {"const": true},
        "request_id": {"$ref": "#/$defs/identifier"},
        "user_id": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "searchRequest": {
      "type": "object", "required": ["query", "user_id", "top_k"],
      "properties": {
        "query": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "user_id": {"$ref": "#/$defs/identifier"},
        "top_k": {"type": "integer", "minimum": 1, "maximum": 100},
        "options": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}
      },
      "additionalProperties": true
    },
    "searchResponse": {
      "type": "object", "required": ["data"],
      "properties": {
        "data": {"type": "array", "maxItems": 100, "items": {
          "type": "object", "required": ["id", "content"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "content": {"type": "string", "minLength": 1},
            "score": {"type": "number"},
            "created_at": {"type": "string", "format": "date-time"}
          },
          "additionalProperties": false
        }}
      },
      "additionalProperties": false
    }
  }
}
