# Private service credentials. Never commit the real .env or disclose either key.
MEMORY_API_KEY=
MODEL_MODE=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_TIMEOUT_SECONDS=90
MAX_MODEL_CONCURRENCY=2

# Optional permitted embedding baseline. v4 means text-embedding-v4 only.
EMBEDDING_MODE=none
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

STRATEGY=proposed
MAX_ADD_CONCURRENCY=2
MAX_SEARCH_CONCURRENCY=2
# Conservative wire-body limit for the 1GiB deployment; larger caps need testing.
MAX_REQUEST_BYTES=8388608
MAX_RESPONSE_BYTES=16777216
MAX_RESULTS=100
MIN_FREE_BYTES=1073741824
READ_TIMEOUT_SECONDS=120
PRODUCTION=1
SYSTEM_VERSION=0.1.0
SOURCE_COMMIT=unfixed
PUBLIC_PORT=8000
BIND_HOST=0.0.0.0
CPU_LIMIT=1.5
MEMORY_LIMIT=1024m
IMAGE_TAG=0.1.0
BASE_IMAGE=python:3.11-slim-bookworm
FORGE_PIP_INDEX=https://pypi.org/simple

# MODEL_MODE=offline performs no paid calls and is only a local diagnostic.
# Changing models, strategy, or frozen parameters requires a separate database.
